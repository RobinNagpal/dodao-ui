{
  "name": "dodao-home",
  "version": "1.0.0",
  "private": true,
  "description": "dodao.io marketing site — a fully static Next.js export served from S3 + CloudFront.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "serve": "npx --yes serve@14 out",
    "compile": "tsc",
    "lint": "next lint",
    "lint-fix": "eslint . --ext .ts,.js,.tsx --fix",
    "prettier-fix": "prettier --config .prettierrc 'src/**/*.{js,ts,tsx,json}' --write",
    "prettier-check": "prettier --check 'src/**/*.{js,ts,tsx,json}'"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@dodao/web-core": "workspace:*",
    "@heroicons/react": "2.1.5",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.0.1",
    "@tailwindcss/forms": "^0.5.3",
    "@types/mdx": "^2.0.13",
    "autoprefixer": "10.4.14",
    "clsx": "^2.1.1",
    "next": "15.5.27",
    "postcss": "8.4.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sass": "^1.62.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.0.4"
  },
  "devDependencies": {
    "@types/node": "18.16.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "eslint": "8.39.0",
    "eslint-config-next": "13.3.4",
    "prettier": "^2.8.8"
  }
}
