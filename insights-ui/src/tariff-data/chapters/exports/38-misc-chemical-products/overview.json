    "seo": {
      "title": "U.S. Chemical Products Exports and Foreign Tariffs (HTS Ch. 38) | KoalaGains",
      "shortDescription": "U.S. exports of miscellaneous chemical products (reagents, pesticides, catalysts, additives) were $36.19B in 2025, down 2.8%. Who buys them and what the EU, China and Canada charge.",
      "keywords": ["US chemical exports", "US pesticide exports", "diagnostic reagent exports", "tariffs on US chemical products", "HS 38 exports by country"]
