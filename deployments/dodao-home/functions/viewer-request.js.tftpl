// CloudFront viewer-request function for the static dodao.io export.
//
// In order:
//  1. www.${domain_name} is a redirect-only alias — 301 to the apex over https,
//     preserving path and query string.
//  2. A trailing slash (other than "/") 301s to the slash-less URL, which is the
//     canonical form every page, sitemap entry and <link rel=canonical> uses.
//  3. `next build` (output: 'export', trailingSlash: false) writes each route as
//     <route>.html, so an extension-less path such as /robotics or
//     /home-section/dodao-io/products/tidbitshub is served from that .html
//     object. Paths whose last segment has a dot (/_next/static/..., /robots.txt,
//     /robotics/poster.pdf, the RSC *.txt payloads) are real files and pass
//     through. "/" is served by the distribution's default_root_object.
var APEX = "${domain_name}";
var WWW = "www.${domain_name}";

function queryString(querystring) {
  var parts = [];
  for (var key in querystring) {
    var param = querystring[key];
    if (param.multiValue) {
      for (var i = 0; i < param.multiValue.length; i++) {
        parts.push(key + "=" + param.multiValue[i].value);
      }
    } else if (param.value === "") {
      parts.push(key);
    } else {
      parts.push(key + "=" + param.value);
    }
  }
  return parts.length ? "?" + parts.join("&") : "";
}

function redirect(location) {
  return {
    statusCode: 301,
    statusDescription: "Moved Permanently",
    headers: {
      location: { value: location },
      "cache-control": { value: "public, max-age=3600" },
    },
  };
}

function handler(event) {
  var request = event.request;
  var host = request.headers.host ? request.headers.host.value.toLowerCase() : "";
  var uri = request.uri;

  if (host === WWW) {
    return redirect("https://" + APEX + uri + queryString(request.querystring));
  }

  if (uri.length > 1 && uri.endsWith("/")) {
    var trimmed = uri.replace(/\/+$/, "");
    return redirect((trimmed === "" ? "/" : trimmed) + queryString(request.querystring));
  }

  var lastSegment = uri.substring(uri.lastIndexOf("/") + 1);
  if (uri !== "/" && lastSegment.indexOf(".") === -1) {
    request.uri = uri + ".html";
  }

  return request;
}
